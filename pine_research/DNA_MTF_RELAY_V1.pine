//@version=6
// DNA MTF Webhook Relay v1 — research-only, runs ALONGSIDE native alerts.
//
// One alert per asset (anchor = 1m) that pulls the tracked timeframes inside
// Pine via request.security() and emits a single batched payload whenever any
// tracked bar closes with a new event. This collapses ~10 alerts/asset to 1.
//
// BOUNDARIES (see docs/DEEPSEEK_MTF_RELAY_BUILD_TASK.md):
//   - Do NOT activate this as a replacement for native per-timeframe alerts.
//     It runs beside them for parity comparison only.
//   - Native AMC alerts stay untouched. Only retire them after the relay
//     demonstrates acceptable parity (docs/TRADINGVIEW_ALERT_CAPACITY_PLAN.md).
//   - The webhook receiver stores relay rows in a separate `alerts_relay`
//     table; they never feed the native DNA read.
//
// MANUAL STEPS (Tiago, in TradingView — DS cannot touch the TV UI):
//   1. Add this script to the chart on the 1m timeframe for the asset.
//   2. Create ONE Alert on it (Condition = "This indicator", alert() trigger),
//      Webhook URL = the same /webhook URL the native alerts use.
//   3. Message must be empty (this script's alert() builds the JSON payload).
//   4. Recreate the alert after ANY edit to this script (alerts snapshot the
//      script at creation time).
//
// EVENT NOTE (v1): `dnaEvent()` below is a self-contained price-action port of
// the production DNA event cascade's *vocabulary* — it is NOT a byte-for-byte
// port of the stateful production indicator (campaignHealth persistence,
// pendingActive, resolvedAddEvent, Trade Box). Parity against native is
// measured by scripts/compare_mtf_relay.py; the stateful parts are the
// known gap to tune on-platform.

indicator("DNA MTF Webhook Relay v1 (research)", overlay=true)

// --- tracked timeframes (anchored on 1m) -----------------------------------
// All ten tracked timeframes. `relaySymbol` lets the same script be reused
// per asset without hardcoding syminfo.tickerid.
relaySymbol = input.string(syminfo.tickerid, "Relay symbol")
trackTfs = input.string("3,5,15,30,60,120,180,240,D,W", "Tracked timeframes (comma)", group="Relay")

// --- DNA event vocabulary (self-contained, price-action only) ---------------
// Mirrors the production phase families. `var`-free on purpose: request.security()
// cannot reliably persist var state per timeframe, so this v1 approximates the
// phase from the current bar only. This is the documented parity gap.
f_ema(series, len) =>
    ta.ema(series, len)

f_dnaPhase() =>
    ema21 = f_ema(close, 21)
    ema50 = f_ema(close, 50)
    ema21Slope = ema21 - ema21[1]
    ema50Slope = ema50 - ema50[1]
    above21 = close > ema21
    above50 = close > ema50
    r = ta.rsi(close, 14)
    result = "WAIT"
    if ema21Slope > 0 and ema50Slope > 0 and above21 and above50
        result := "EXPANSION"
    else if ema21Slope > 0 and above21 and r > 50
        result := "ACCUMULATE"
    else if ema21Slope < 0 and ema50Slope < 0 and not above21
        result := "FAILED"
    else if ema21Slope < 0 and not above21
        result := "FAIL TEST"
    else if r > 70 and above21
        result := "MANAGE"
    result

// Event = the phase itself for v1 (a real discrete event string); the
// receiver's infer_event_from_payload() reads the "event" field directly.
f_dnaEvent() =>
    f_dnaPhase()

// --- per-timeframe security pulls (no lookahead) ----------------------------
tfs = str.split(trackTfs, ",")
requestString(tf) =>
    request.security(relaySymbol, tf, f_dnaEvent(), lookahead=barmerge.lookahead_off, gaps=barmerge.gaps_off)

requestTime(tf) =>
    request.security(relaySymbol, tf, time, lookahead=barmerge.lookahead_off, gaps=barmerge.gaps_off)

requestClose(tf) =>
    request.security(relaySymbol, tf, close, lookahead=barmerge.lookahead_off, gaps=barmerge.gaps_off)

// --- assemble a batched payload on anchor-bar close -------------------------
// Alert-storm safety: emit AT MOST one alert per anchor bar close, and only
// when at least one tracked bar actually closed this anchor bar (its security
// bar time advanced). Dedup is the receiver's job via per-timeframe bar time.
var string payload = ""
var bool anyChanged = false

// Build one JSON event fragment per tracked timeframe whose bar just closed.
eventJson(tf) =>
    ev = requestString(tf)
    t = requestTime(tf)
    c = requestClose(tf)
    tfChanged = not na(t) and not na(t[1]) and t != t[1]
    out = ""
    if tfChanged
        out := "{\"timeframe\":\"" + tf + "\",\"event\":\"" + ev + "\",\"time\":" + str.tostring(t) + ",\"close\":" + str.tostring(c) + ",\"phase\":\"" + ev + "\"}"
    out

// Pine cannot loop over an input array for request.security() dynamically at
// compile time; emit one fragment per literal tracked timeframe. To keep the
// payload batched we concatenate the fixed set below. (Adjust the list here if
// the tracked set changes — it must match `trackTfs`.)
tf3m = eventJson("3")
tf5m = eventJson("5")
tf15m = eventJson("15")
tf30m = eventJson("30")
tf1H = eventJson("60")
tf2H = eventJson("120")
tf3H = eventJson("180")
tf4H = eventJson("240")
tfD = eventJson("D")
tfW = eventJson("W")

// Non-empty fragments only; comma-join.
fragJoin(f1, f2) => f1 != "" and f2 != "" ? f1 + "," + f2 : f1 != "" ? f1 : f2
allFrags = fragJoin(fragJoin(fragJoin(fragJoin(fragJoin(fragJoin(fragJoin(fragJoin(fragJoin(tf3m, tf5m), tf15m), tf30m), tf1H), tf2H), tf3H), tf4H), tfD), tfW)

if barstate.isconfirmed and timeframe.isminutes and timeframe.multiplier == 1 and allFrags != ""
    alert("{\"relay\":true,\"symbol\":\"" + relaySymbol + "\",\"events\":[" + allFrags + "]}", alert.freq_once_per_bar_close)

plot(close, "anchor", color=color.new(color.gray, 100), display=display.data_window)
